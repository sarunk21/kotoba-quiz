<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Flame Icon + Streak Text -->
        <TextView
            android:id="@+id/widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kotoba Quiz"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16 Hari Beruntun"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Status Badge -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="✨ AKTIF"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7-Day Activity Dot Tracker Row -->
    <LinearLayout
        android:id="@+id/widget_weekly_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Monday (Sen) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sen"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_0"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tuesday (Sel) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sel"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wednesday (Rab) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rab"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Thursday (Kam) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kam"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Friday (Jum) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jum"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_4"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Saturday (Sab) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sab"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_5"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sunday (Min) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Min"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_day_6"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="○"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Status Text -->
    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✨ Apimu aman dan menyala hari ini!"
        android:textColor="#34D399"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
